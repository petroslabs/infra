# Copier vers .env.docker et personnaliser (production, sur le VPS).
# Usage : docker compose --env-file .env.docker -f compose.prod.yaml up -d
#         (ou : make up-prod)

# Adresse du compte ACME Let's Encrypt. Obligatoire : la pile refuse de
# démarrer sans.
ACME_EMAIL=

# Autorité de certification. Pour un premier déploiement, viser le bac à
# sable pour ne pas épuiser les quotas de la production sur une config DNS
# approximative :
#   ACME_CA_SERVER=https://acme-staging-v02.api.letsencrypt.org/directory
ACME_CA_SERVER=https://acme-v02.api.letsencrypt.org/directory
